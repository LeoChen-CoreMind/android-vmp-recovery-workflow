{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "case_id", "package", "dex_inputs", "profile", "config_revision", "state"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "package": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$"},
    "device_serial": {"type": ["string", "null"]},
    "dex_inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "apk": {"type": ["string", "null"]},
    "profile": {"type": "string"},
    "config_revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["INIT", "TARGET_CONFIRMED", "SO_DUMPED", "SO_REPAIRED", "IDA_EXTRACTED", "SIMULATION_CONFIRMED", "DEX_RESTORED", "VALIDATED", "BLOCKED"]}
  }
}
