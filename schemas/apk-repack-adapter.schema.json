{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apk-repack-adapter.schema.json",
  "title": "Version-specific 360 shell removal and APK repack adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adapter_id", "evidence_revision", "case_revision", "package", "apk_sha256",
    "shell", "manifest", "dex_layout", "remove_entries", "replace_entries", "bridge_contracts",
    "executor", "validation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "evidence_revision": {"type": "integer", "minimum": 1},
    "case_revision": {"type": "integer", "minimum": 1},
    "package": {"type": "string", "minLength": 1},
    "apk_sha256": {"$ref": "#/$defs/sha256"},
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "fingerprints"],
      "properties": {
        "family": {"const": "360"},
        "version": {"type": "string", "minLength": 1},
        "fingerprints": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "value", "evidence"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["application", "app_component_factory"],
      "properties": {
        "application": {"$ref": "#/$defs/evidencedValue"},
        "app_component_factory": {"$ref": "#/$defs/evidencedValue"}
      }
    },
    "dex_layout": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "source_sha256", "target", "output_sha256", "evidence"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "target": {"type": "string", "pattern": "^classes(?:[2-9][0-9]*)?\\.dex$"},
          "output_sha256": {"$ref": "#/$defs/sha256"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "remove_entries": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^[^*?\\[\\]\\\\]+$"}
    },
    "replace_entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "output_sha256", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "pattern": "^[^*?\\[\\]\\\\]+$"},
          "output_sha256": {"$ref": "#/$defs/sha256"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "bridge_contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptor_replacements", "calls"],
      "properties": {
        "descriptor_replacements": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["old", "new", "same_length", "expected_occurrences", "targets", "ordering_evidence"],
            "properties": {
              "old": {"type": "string", "minLength": 1},
              "new": {"type": "string", "minLength": 1},
              "same_length": {"const": true},
              "expected_occurrences": {"type": "integer", "minimum": 1},
              "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^classes(?:[2-9][0-9]*)?\\.dex$"}},
              "ordering_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["owner", "name", "descriptor", "strategy", "callsite_count", "evidence"],
            "properties": {
              "owner": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "descriptor": {"type": "string", "minLength": 1},
              "strategy": {"enum": ["application-context", "no-op", "bridge"]},
              "callsite_count": {"type": "integer", "minimum": 1},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "output_apk"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "output_apk": {"type": "string", "minLength": 1}
      }
    },
    "signing": {
      "type": "object", "additionalProperties": false,
      "required": ["certificate_sha256", "required_schemes"],
      "properties": {
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "required_schemes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["v1", "v2", "v3", "v4"]}}
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "launch_component", "acceptance_window_seconds"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "launch_component": {"type": "string", "minLength": 1},
        "acceptance_window_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest", "dexdump", "jadx", "zipalign", "signature", "device"],
      "properties": {
        "manifest": {"const": true},
        "dexdump": {"const": true},
        "jadx": {"const": true},
        "zipalign": {"const": true},
        "signature": {"const": true},
        "device": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {"anyOf": [
      {"properties": {"remove_entries": {"minItems": 1}}},
      {"properties": {"replace_entries": {"minItems": 1}}}
    ]},
    {"if": {"properties": {"validation": {"properties": {"signature": {"const": true}}}}}, "then": {"required": ["signing"]}},
    {"if": {"properties": {"validation": {"properties": {"device": {"const": true}}}}}, "then": {"required": ["device"]}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidencedValue": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "evidence"],
      "properties": {
        "value": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
